<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<TabPane prefHeight="500.0" prefWidth="700.0" tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="scs.ui.DashboardController">
    <tabs>
        <Tab text="Doresc sa ajut!">
            <VBox spacing="15.0">
                <padding>
                    <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
                </padding>

                <Label text="Nevoile orasului (Fara cererile tale)" style="-fx-font-weight: bold;"/>
                <TableView fx:id="nevoiOrasTable" prefHeight="200.0">
                    <columns>
                        <TableColumn fx:id="colTitluOras" text="Titlu" prefWidth="150.0"/>
                        <TableColumn fx:id="colDescriereOras" text="Descriere" prefWidth="200.0"/>
                        <TableColumn fx:id="colDeadlineOras" text="Deadline" prefWidth="150.0"/>
                        <TableColumn fx:id="colStatusOras" text="Status" prefWidth="150.0"/>
                    </columns>
                </TableView>

                <Button text="Preia nevoie (Fii Erou!)" onAction="#handlePreiaNevoie"/>

                <Separator/>

                <Label text="Faptele mele bune" style="-fx-font-weight: bold;"/>
                <TableView fx:id="fapteBuneTable" prefHeight="150.0">
                    <columns>
                        <TableColumn fx:id="colTitluFapte" text="Titlu" prefWidth="150.0"/>
                        <TableColumn fx:id="colDescriereFapte" text="Descriere" prefWidth="200.0"/>
                        <TableColumn fx:id="colDeadlineFapte" text="Deadline" prefWidth="150.0"/>
                        <TableColumn fx:id="colStatusFapte" text="Status" prefWidth="150.0"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Doresc sa fiu ajutat!">
            <VBox spacing="15.0" maxWidth="400.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <Label text="Adauga o noua nevoie" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <TextField fx:id="titluNevoieField" promptText="Titlu nevoie"/>
                <TextArea fx:id="descriereNevoieField" promptText="Descrie problema pe scurt..." prefRowCount="4"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Deadline:"/>
                    <DatePicker fx:id="deadlinePicker" promptText="Alege data limita"/>
                </HBox>

                <Button text="Adauga Nevoie" onAction="#handleAdaugaNevoie" prefWidth="200.0"/>
            </VBox>
        </Tab>
    </tabs>
</TabPane>